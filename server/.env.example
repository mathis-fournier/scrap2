# Authentication Environment Variables
# Copy this file to .env and fill in your values

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here_change_this_in_production
JWT_REFRESH_SECRET=your_super_secret_refresh_key_here_change_this_in_production

# Token Expiry Times
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Session & Inactivity Configuration (in milliseconds)
# 30 minutes = 1800000 ms
INACTIVITY_TIMEOUT=1800000

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

# Frontend URL (for OAuth and CORS)
FRONTEND_URL=http://localhost:5173

# Discord OAuth (if using Discord login)
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback
